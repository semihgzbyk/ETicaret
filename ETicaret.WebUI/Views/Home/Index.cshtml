@model ETicaret.WebUI.Models.HomeViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="p-5 mb-4 bg-light rounded-3 text-center">
    <h1 class="display-5 fw-bold">ETicaret'e Hoş Geldiniz</h1>
    <p class="fs-5 text-muted">Binlerce ürün, uygun fiyatlar.</p>
</div>

<h4 class="mb-3">Kategoriler</h4>
<div class="d-flex flex-wrap gap-2 mb-5">
    @foreach (var category in Model.Categories)
    {
        <a class="btn btn-outline-primary" href="#">@category.Name</a>
    }
</div>

<h4 class="mb-3">Öne Çıkan Ürünler</h4>
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
    @foreach (var product in Model.FeaturedProducts)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name"
                     style="height:200px;object-fit:cover;">
                <div class="card-body d-flex flex-column">
                    <small class="text-muted">@product.Category?.Name · @product.Brand?.Name</small>
                    <h6 class="card-title mt-1">@product.Name</h6>
                    <div class="mt-auto">
                        @if (product.DiscountPrice.HasValue)
                        {
                            <span class="text-muted text-decoration-line-through">@product.Price.ToString("N2") ₺</span>
                            <span class="fw-bold text-danger ms-1">@product.DiscountPrice.Value.ToString("N2") ₺</span>
                        }
                        else
                        {
                            <span class="fw-bold">@product.Price.ToString("N2") ₺</span>
                        }
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <a class="btn btn-primary w-100" href="#">İncele</a>
                </div>
            </div>
        </div>
    }
</div>