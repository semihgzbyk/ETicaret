@model ETicaret.WebUI.Models.ProductDetailViewModel
@{
    var p = Model.Product;
    ViewData["Title"] = p.Name;
}
<div style="height:60px"></div>
<!-- Breadcrumb -->
<div class="container">
    <div class="p-t-30 p-l-25 p-lr-0-lg">
        <button type="button" id="back-btn"
                data-fallback="@Url.Action("Index", "Products", new { categoryId = p.CategoryId })"
                class="stext-109 cl8 hov-cl1 trans-04" style="background:none; border:none; padding:0; cursor:pointer;">
            <i class="fa fa-angle-left m-r-9" aria-hidden="true"></i>Geri
        </button>
    </div>

    <div class="bread-crumb flex-w p-l-25 p-r-15 p-t-20 p-lr-0-lg">
        <a asp-controller="Home" asp-action="Index" class="stext-109 cl8 hov-cl1 trans-04">
            Ana Sayfa
            <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
        </a>

        <a asp-action="Index" asp-route-categoryId="@p.CategoryId" class="stext-109 cl8 hov-cl1 trans-04">
            @p.Category?.Name
            <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
        </a>

        <span class="stext-109 cl4">@p.Name</span>
    </div>
</div>

<!-- Ürün detayı -->
<section class="sec-product-detail bg0 p-t-65 p-b-60">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-lg-7 p-b-30">
                <div class="p-l-25 p-r-30 p-lr-0-lg">
                    <div class="wrap-pic-w pos-relative">
                        <img src="@p.ImageUrl" alt="@p.Name">
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-5 p-b-30">
                <div class="p-r-50 p-t-5 p-lr-0-lg">
                    <h4 class="mtext-105 cl2 p-b-14">@p.Name</h4>

                    <span class="mtext-106 cl2">
                        @if (p.DiscountPrice.HasValue)
                        {
                            <del class="m-r-10 cl6">@p.Price.ToString("N2") ₺</del>
                            <strong>@p.DiscountPrice.Value.ToString("N2") ₺</strong>
                        }
                        else
                        {
                            @:@p.Price.ToString("N2") ₺
                        }
                    </span>

                    <p class="stext-102 cl3 p-t-23">
                        @(string.IsNullOrWhiteSpace(p.Description) ? "Bu ürün için açıklama bulunmuyor." :
                        p.Description)
                    </p>

                    <p class="stext-102 p-t-15">
                        @if (p.Stock > 0)
                        {
                            <span class="cl3">Stok: @p.Stock adet</span>
                        }
                        else
                        {
                            <span class="cl1">Tükendi</span>
                        }
                    </p>

                    @if (p.Stock > 0)
                    {
                        <div class="p-t-33">
                            <div class="flex-w flex-r-m p-b-10">
                                <div class="size-204 flex-w flex-m respon6-next">
                                    <div class="wrap-num-product flex-w m-r-20 m-tb-10">
                                        <div class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m">
                                            <i class="fs-16 zmdi zmdi-minus"></i>
                                        </div>

                                        <input class="mtext-104 cl3 txt-center num-product" type="number" name="quantity"
                                               id="quantity" value="1" min="1" max="@p.Stock">

                                        <div class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m">
                                            <i class="fs-16 zmdi zmdi-plus"></i>
                                        </div>
                                    </div>

                                    <button type="button" data-product-id="@p.Id"
                                            class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04 js-add-to-cart">
                                        Sepete Ekle
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sekmeler -->
        <div class="bor10 m-t-50 p-t-43 p-b-40">
            <div class="tab01">
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item p-b-10">
                        <a class="nav-link active" data-toggle="tab" href="#description" role="tab">Açıklama</a>
                    </li>
                    <li class="nav-item p-b-10">
                        <a class="nav-link" data-toggle="tab" href="#information" role="tab">Ek Bilgi</a>
                    </li>
                </ul>

                <div class="tab-content p-t-43">
                    <div class="tab-pane fade show active" id="description" role="tabpanel">
                        <div class="how-pos2 p-lr-15-md">
                            <p class="stext-102 cl6">
                                @(string.IsNullOrWhiteSpace(p.Description) ? "Bu ürün için açıklama bulunmuyor." :
                                p.Description)
                            </p>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="information" role="tabpanel">
                        <div class="row">
                            <div class="col-sm-10 col-md-8 col-lg-6 m-lr-auto">
                                <ul class="p-lr-28 p-lr-15-sm">
                                    <li class="flex-w flex-t p-b-7">
                                        <span class="stext-102 cl3 size-205">Marka</span>
                                        <span class="stext-102 cl6 size-206">@p.Brand?.Name</span>
                                    </li>
                                    <li class="flex-w flex-t p-b-7">
                                        <span class="stext-102 cl3 size-205">Kategori</span>
                                        <span class="stext-102 cl6 size-206">@p.Category?.Name</span>
                                    </li>
                                    <li class="flex-w flex-t p-b-7">
                                        <span class="stext-102 cl3 size-205">Stok</span>
                                        <span class="stext-102 cl6 size-206">@p.Stock adet</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="bg6 flex-c-m flex-w size-302 m-t-73 p-tb-15">
        <span class="stext-107 cl6 p-lr-25">Ürün No: @p.Id</span>
        <span class="stext-107 cl6 p-lr-25">Kategori: @p.Category?.Name</span>
        <span class="stext-107 cl6 p-lr-25">Marka: @p.Brand?.Name</span>
    </div>
</section>

<!-- Benzer ürünler -->
@if (Model.RelatedProducts.Any())
{
    <section class="sec-relate-product bg0 p-t-45 p-b-105">
        <div class="container">
            <div class="p-b-45">
                <h3 class="ltext-106 cl5 txt-center">Şu Ürünlere de Göz Atabilirsiniz</h3>
            </div>

            <div class="wrap-slick2">
                <div class="slick2">
                    @foreach (var r in Model.RelatedProducts)
                    {
                        <div class="item-slick2 p-l-15 p-r-15 p-t-15 p-b-15">
                            <div class="block2">
                                <div class="block2-pic hov-img0">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@r.Id" class="dis-block">
                                        <img src="@r.ImageUrl" alt="@r.Name">
                                    </a>

                                    <a href="#" data-product-id="@r.Id"
                                       class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04 js-add-to-cart">
                                        Sepete Ekle
                                    </a>
                                </div>

                                <div class="block2-txt flex-w flex-t p-t-14">
                                    <div class="block2-txt-child1 flex-col-l">
                                        <a asp-action="Details" asp-route-id="@r.Id"
                                           class="stext-104 cl4 hov-cl1 trans-04 p-b-6">
                                            @r.Name
                                        </a>

                                        <span class="stext-105 cl3">
                                            @if (r.DiscountPrice.HasValue)
                                            {
                                                <del class="m-r-5">@r.Price.ToString("N2") ₺</del>
                                                <strong class="cl1">@r.DiscountPrice.Value.ToString("N2") ₺</strong>
                                            }
                                            else
                                            {
                                                @:@r.Price.ToString("N2") ₺
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    @section Scripts {
        <script>
            $('#back-btn').on('click', function () {
                // Aynı siteden geldiyse tarayıcı geçmişinde geri git (konum korunur)
                if (document.referrer && document.referrer.indexOf(location.origin) === 0) {
                    history.back();
                } else {
                    window.location.href = $(this).data('fallback');
                }
            });
        </script>
    }
}