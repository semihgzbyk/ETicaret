@model ETicaret.WebUI.Models.ProductListViewModel
@{
    ViewData["Title"] = "Ürünler";

    var priceRanges = new (string Label, decimal? Min, decimal? Max)[]
    {
        ("Tümü", null, null),
        ("0 - 500 ₺", null, 500),
        ("500 - 1.000 ₺", 500, 1000),
        ("1.000 - 5.000 ₺", 1000, 5000),
        ("5.000 - 20.000 ₺", 5000, 20000),
        ("20.000 ₺ ve üzeri", 20000, null)
    };
}

<div class="bg0 p-b-140" style="margin-top: 75px; border-top: 1px solid #e6e6e6; padding-top: 23px;">
    <div class="container">
    

        <div class="flex-w flex-sb-m p-b-52">

            <!-- Kategori linkleri -->
            <div class="flex-w flex-l-m filter-tope-group m-tb-10">
                <a asp-action="Index" asp-route-brandId="@Model.BrandId" asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice" asp-route-search="@Model.Search"
                   class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5 @(Model.CategoryId == null ? "how-active1" : "")">
                    Tüm Ürünler
                </a>

                @foreach (var c in Model.Categories)
                {
                    <a asp-action="Index" asp-route-categoryId="@c.Id" asp-route-brandId="@Model.BrandId"
                       asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                       asp-route-search="@Model.Search"
                       class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5 @(Model.CategoryId == c.Id ? "how-active1" : "")">
                        @c.Name
                    </a>
                }
            </div>

            <!-- Filtre ve Arama butonları -->
            <div class="flex-w flex-c-m m-tb-10">
                <div class="flex-c-m stext-106 cl6 size-104 bor4 pointer hov-btn3 trans-04 m-r-8 m-tb-4 js-show-filter">
                    <i class="icon-filter cl2 m-r-6 fs-15 trans-04 zmdi zmdi-filter-list"></i>
                    <i class="icon-close-filter cl2 m-r-6 fs-15 trans-04 zmdi zmdi-close dis-none"></i>
                    Filtre
                </div>

                <div class="flex-c-m stext-106 cl6 size-105 bor4 pointer hov-btn3 trans-04 m-tb-4 js-show-search">
                    <i class="icon-search cl2 m-r-6 fs-15 trans-04 zmdi zmdi-search"></i>
                    <i class="icon-close-search cl2 m-r-6 fs-15 trans-04 zmdi zmdi-close dis-none"></i>
                    Ara
                </div>
            </div>

            <!-- Arama paneli -->
            <div class="dis-none panel-search w-full p-t-10 p-b-15">
                <form method="get" asp-action="Index" class="bor8 dis-flex p-l-15">
                    <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                    <input type="hidden" name="brandId" value="@Model.BrandId" />
                    <input type="hidden" name="minPrice" value="@Model.MinPrice" />
                    <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />

                    <button type="submit" class="size-113 flex-c-m fs-16 cl2 hov-cl1 trans-04">
                        <i class="zmdi zmdi-search"></i>
                    </button>
                    <input class="mtext-107 cl2 size-114 plh2 p-r-15" type="text" name="search" value="@Model.Search"
                           placeholder="Ürün ara">
                </form>
            </div>

            <!-- Filtre paneli -->
            <div class="dis-none panel-filter w-full p-t-10">
                <div class="wrap-filter flex-w bg6 w-full p-lr-40 p-t-27 p-lr-15-sm">

                    <div class="filter-col1 p-r-15 p-b-27">
                        <div class="mtext-102 cl2 p-b-15">Marka</div>
                        <ul>
                            <li class="p-b-6">
                                <a asp-action="Index" asp-route-categoryId="@Model.CategoryId"
                                   asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-search="@Model.Search"
                                   class="filter-link stext-106 trans-04 @(Model.BrandId == null ? "filter-link-active" : "")">
                                    Tümü
                                </a>
                            </li>
                            @foreach (var b in Model.Brands)
                            {
                                <li class="p-b-6">
                                    <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" asp-route-brandId="@b.Id"
                                       asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                                       asp-route-search="@Model.Search"
                                       class="filter-link stext-106 trans-04 @(Model.BrandId == b.Id ? "filter-link-active" : "")">
                                        @b.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="filter-col2 p-r-15 p-b-27">
                        <div class="mtext-102 cl2 p-b-15">Fiyat</div>
                        <ul>
                            @foreach (var r in priceRanges)
                            {
                                <li class="p-b-6">
                                    <a asp-action="Index" asp-route-categoryId="@Model.CategoryId"
                                       asp-route-brandId="@Model.BrandId" asp-route-minPrice="@r.Min"
                                       asp-route-maxPrice="@r.Max" asp-route-search="@Model.Search"
                                       class="filter-link stext-106 trans-04 @(Model.MinPrice == r.Min && Model.MaxPrice == r.Max ? "filter-link-active" : "")">
                                        @r.Label
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="filter-col4 p-b-27">
                        <div class="mtext-102 cl2 p-b-15">Temizle</div>
                        <a asp-action="Index" class="stext-106 cl6 hov-cl1 trans-04">
                            Tüm filtreleri kaldır
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <p class="stext-107 cl6 p-b-30">@Model.TotalCount ürün bulundu</p>

        @if (!Model.Products.Any())
        {
            <div class="p-tb-50 txt-center stext-102 cl6">
                Bu filtrelere uygun ürün bulunamadı.
            </div>
        }

        <!-- Ürünler -->
        <div class="row">
            @foreach (var p in Model.Products)
            {
                <div class="col-sm-6 col-md-4 col-lg-3 p-b-35">
                    <div class="block2">
                        <div class="block2-pic hov-img0">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="dis-block">
                                <img src="@p.ImageUrl" alt="@p.Name">
                            </a>

                            <a href="#" data-product-id="@p.Id"
                               class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04 js-add-to-cart">
                                Sepete Ekle
                            </a>
                        </div>

                        <div class="block2-txt flex-w flex-t p-t-14">
                            <div class="block2-txt-child1 flex-col-l">
                                <a asp-action="Details" asp-route-id="@p.Id" class="stext-104 cl4 hov-cl1 trans-04 p-b-6">
                                    @p.Name
                                </a>

                                <span class="stext-105 cl3">
                                    @if (p.DiscountPrice.HasValue)
                                    {
                                        <del class="m-r-5">@p.Price.ToString("N2") ₺</del>
                                        <strong class="cl1">@p.DiscountPrice.Value.ToString("N2") ₺</strong>
                                    }
                                    else
                                    {
                                        @:@p.Price.ToString("N2") ₺
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sayfalama -->
        @if (Model.TotalPages > 1)
        {
            <div class="flex-c-m flex-w w-full p-t-30">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-action="Index" asp-route-page="@i" asp-route-categoryId="@Model.CategoryId"
                       asp-route-brandId="@Model.BrandId" asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice" asp-route-search="@Model.Search" style="width:42px;height:42px;"
                       class="flex-c-m stext-101 bor1 hov-btn1 trans-04 m-lr-5 m-b-10 @(i == Model.Page ? "bg1 cl0" : "bg2 cl5")">
                        @i
                    </a>
                }
            </div>
        }
    </div>
</div>